# .NET build artifacts
bin/
obj/
out/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio / VS Code
.vs/
.vscode/*
!.vscode/extensions.json

# Rider / ReSharper
.idea/
*.DotSettings.user

# Database (SQLite dev database, created at runtime via migrations)
*.db
*.db-shm
*.db-wal

# EF Core / dotnet-ef logs
*.log

# OS files
.DS_Store
Thumbs.db

# NuGet
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/

# ASP.NET Core secrets (never commit local secrets)
appsettings.*.local.json
secrets.json
